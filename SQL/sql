-- =====================================================

-- Trigger: Mettre à jour le statut du ticket quand une réservation est confirmée
DELIMITER $$
CREATE TRIGGER after_reservation_confirm
AFTER UPDATE ON reservation
FOR EACH ROW
BEGIN
    IF NEW.statut = 'CONFIRMEE' AND OLD.statut != 'CONFIRMEE' THEN
        INSERT INTO journal_activite (type_action, description, date_action)
        VALUES ('RESERVATION_CONFIRMEE', CONCAT('Réservation ', NEW.numero_reservation, ' confirmée'), NOW());
    END IF;
END$$
DELIMITER ;

