-- Insertion des sièges (exemple pour quelques wagons)
DELIMITER $$
CREATE PROCEDURE generer_sieges()
BEGIN
    DECLARE v_wagon_id INT;
    DECLARE v_classe VARCHAR(20);
    DECLARE v_capacite INT;
    DECLARE v_i INT;
    DECLARE done INT DEFAULT FALSE;
    
    DECLARE wagon_cursor CURSOR FOR SELECT id_wagon, classe, capacite FROM wagon WHERE id_train = 1;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    OPEN wagon_cursor;
    
    read_loop: LOOP
        FETCH wagon_cursor INTO v_wagon_id, v_classe, v_capacite;
        IF done THEN
            LEAVE read_loop;
        END IF;
        
        SET v_i = 1;
        WHILE v_i <= v_capacite DO
            INSERT INTO siege (numero_siege, id_wagon, est_occupe) VALUES (v_i, v_wagon_id, FALSE);
            SET v_i = v_i + 1;
        END WHILE;
    END LOOP;
    
    CLOSE wagon_cursor;
END$$
DELIMITER ;

CALL generer_sieges();
