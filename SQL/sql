-- Vue: Réservations avec détails complets
CREATE VIEW vue_reservations_completes AS
SELECT 
    r.numero_reservation,
    r.date_reservation,
    r.statut,
    r.prix_total,
    r.date_voyage,
    CONCAT(v.nom, ' ', v.prenom) AS voyageur,
    v.email,
    v.telephone,
    a_depart.nom AS gare_depart,
    a_arrivee.nom AS gare_arrivee,
    t.numero_train,
    t.nom_train,
    s.numero_siege,
    w.numero_wagon,
    r.classe_choisie
FROM reservation r
JOIN voyageur v ON r.id_voyageur = v.id_voyageur
JOIN train t ON r.id_train = t.id_train
JOIN arret a_depart ON r.id_arret_depart = a_depart.id_arret
JOIN arret a_arrivee ON r.id_arret_arrivee = a_arrivee.id_arret
JOIN siege s ON r.id_siege = s.id_siege
JOIN wagon w ON s.id_wagon = w.id_wagon;

-- Vue: Tickets avec détails
CREATE VIEW vue_tickets_complets AS
SELECT 
    tk.numero_ticket,
    tk.date_emission,
    tk.prix,
    tk.statut,
    r.numero_reservation,
    CONCAT(v.nom, ' ', v.prenom) AS voyageur,
    a_depart.nom AS depart,
    a_arrivee.nom AS arrivee,
    r.date_voyage,
    pv.nom_point_vente
FROM ticket tk
JOIN reservation r ON tk.id_reservation = r.id_reservation
JOIN voyageur v ON r.id_voyageur = v.id_voyageur
JOIN arret a_depart ON r.id_arret_depart = a_depart.id_arret
JOIN arret a_arrivee ON r.id_arret_arrivee = a_arrivee.id_arret
LEFT JOIN point_vente pv ON tk.id_point_vente = pv.id_point_vente;

-- Vue: Statistiques par agence
CREATE VIEW vue_stats_agences AS
SELECT 
    a.nom_agence,
    a.ville,
    COUNT(DISTINCT pv.id_point_vente) AS nb_points_vente,
    COUNT(tk.id_ticket) AS nb_tickets_vendus,
    COALESCE(SUM(tk.prix), 0) AS chiffre_affaires,
    COUNT(DISTINCT r.id_reservation) AS nb_reservations
FROM agence a
LEFT JOIN point_vente pv ON a.id_agence = pv.id_agence
LEFT JOIN ticket tk ON pv.id_point_vente = tk.id_point_vente
LEFT JOIN reservation r ON tk.id_reservation = r.id_reservation
GROUP BY a.id_agence;

