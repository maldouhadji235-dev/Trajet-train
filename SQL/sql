-- Procédure: Créer une réservation
DELIMITER $$
CREATE PROCEDURE creer_reservation(
    IN p_numero VARCHAR(30),
    IN p_id_voyageur INT,
    IN p_id_train INT,
    IN p_id_arret_depart INT,
    IN p_id_arret_arrivee INT,
    IN p_classe VARCHAR(20),
    IN p_date_voyage DATE,
    OUT p_id_reservation INT
)
BEGIN
    DECLARE v_prix_base DECIMAL(12,2) DEFAULT 5000;
    DECLARE v_nb_arrets INT;
    DECLARE v_coefficient DECIMAL(5,2);
    DECLARE v_prix_total DECIMAL(12,2);
    DECLARE v_id_siege INT;
    
    -- Calcul du nombre d'arrêts
    SELECT ABS(a1.position_ordre - a2.position_ordre) INTO v_nb_arrets
    FROM arret a1, arret a2
    WHERE a1.id_arret = p_id_arret_depart AND a2.id_arret = p_id_arret_arrivee;
    
    -- Coefficient selon la classe
    CASE p_classe
        WHEN 'PREMIERE' THEN SET v_coefficient = 1.5;
        WHEN 'WAGON_LIT' THEN SET v_coefficient = 2.5;
        ELSE SET v_coefficient = 1.0;
    END CASE;
    
    SET v_prix_total = v_prix_base * v_nb_arrets * v_coefficient;
    
    -- Trouver un siège disponible
    SELECT s.id_siege INTO v_id_siege
    FROM siege s
    JOIN wagon w ON s.id_wagon = w.id_wagon
    WHERE w.id_train = p_id_train 
      AND w.classe = p_classe 
      AND s.est_occupe = FALSE
    LIMIT 1;
    
    -- Créer la réservation
    INSERT INTO reservation (numero_reservation, id_voyageur, id_train, id_arret_depart, 
                             id_arret_arrivee, id_siege, classe_choisie, prix_total, date_voyage)
    VALUES (p_numero, p_id_voyageur, p_id_train, p_id_arret_depart, 
            p_id_arret_arrivee, v_id_siege, p_classe, v_prix_total, p_date_voyage);
    
    SET p_id_reservation = LAST_INSERT_ID();
    
    -- Occuper le siège
    UPDATE siege SET est_occupe = TRUE WHERE id_siege = v_id_siege;
END$$
DELIMITER ;

-- Procédure: Annuler une réservation
DELIMITER $$
CREATE PROCEDURE annuler_reservation(
    IN p_numero_reservation VARCHAR(30)
)
BEGIN
    DECLARE v_id_siege INT;
    DECLARE v_statut VARCHAR(20);
    
    -- Récupérer le siège et le statut
    SELECT id_siege, statut INTO v_id_siege, v_statut
    FROM reservation WHERE numero_reservation = p_numero_reservation;
    
    -- Annuler la réservation
    UPDATE reservation 
    SET statut = 'ANNULEE' 
    WHERE numero_reservation = p_numero_reservation;
    
    -- Libérer le siège
    IF v_id_siege IS NOT NULL THEN
        UPDATE siege SET est_occupe = FALSE WHERE id_siege = v_id_siege;
    END IF;
    
    -- Mettre à jour le ticket associé
    UPDATE ticket SET statut = 'ANNULE' 
    WHERE id_reservation = (SELECT id_reservation FROM reservation WHERE numero_reservation = p_numero_reservation);
END$$
DELIMITER ;

