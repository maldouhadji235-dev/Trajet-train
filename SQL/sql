-- =====================================================
-- BASE DE DONNÉES - SYSTÈME DE RÉSERVATION DE TRAIN
-- TRAJET: NGAOUNDÉRÉ → N'DJAMÉNA
-- =====================================================

-- Création de la base de données
CREATE DATABASE IF NOT EXISTS train_reservation;
USE train_reservation;

-- =====================================================
-- 1. TABLE train
-- =====================================================
CREATE TABLE train (
    id_train INT PRIMARY KEY AUTO_INCREMENT,
    numero_train VARCHAR(20) NOT NULL UNIQUE,
    nom_train VARCHAR(100) NOT NULL,
    capacite_totale INT DEFAULT 300,
    categorie_classe ENUM('PREMIERE', 'SECONDE', 'WAGON_LIT') NOT NULL,
    date_creation DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- 2. TABLE arret
-- =====================================================
CREATE TABLE arret (
    id_arret INT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(100) NOT NULL,
    position_ordre INT NOT NULL,
    id_train INT,
    latitude DECIMAL(10, 8),
    longitude DECIMAL(11, 8),
    FOREIGN KEY (id_train) REFERENCES train(id_train) ON DELETE SET NULL
);

-- =====================================================
-- 3. TABLE horaire
-- =====================================================
CREATE TABLE horaire (
    id_horaire INT PRIMARY KEY AUTO_INCREMENT,
    id_arret INT NOT NULL,
    heure_depart DATETIME,
    heure_arrivee DATETIME,
    date_voyage DATE NOT NULL,
    duree_minutes INT,
    FOREIGN KEY (id_arret) REFERENCES arret(id_arret) ON DELETE CASCADE
);

-- =====================================================
-- 4. TABLE wagon
-- =====================================================
CREATE TABLE wagon (
    id_wagon INT PRIMARY KEY AUTO_INCREMENT,
    numero_wagon INT NOT NULL,
    id_train INT NOT NULL,
    classe ENUM('PREMIERE', 'SECONDE', 'WAGON_LIT') NOT NULL,
    capacite INT NOT NULL,
    FOREIGN KEY (id_train) REFERENCES train(id_train) ON DELETE CASCADE
);

-- =====================================================
-- 5. TABLE siege
-- =====================================================
CREATE TABLE siege (
    id_siege INT PRIMARY KEY AUTO_INCREMENT,
    numero_siege INT NOT NULL,
    id_wagon INT NOT NULL,
    est_occupe BOOLEAN DEFAULT FALSE,
    est_actif BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (id_wagon) REFERENCES wagon(id_wagon) ON DELETE CASCADE,
    UNIQUE KEY unique_siege_wagon (numero_siege, id_wagon)
);

-- =====================================================
-- 6. TABLE agence
-- =====================================================
CREATE TABLE agence (
    id_agence INT PRIMARY KEY AUTO_INCREMENT,
    code_agence VARCHAR(20) UNIQUE NOT NULL,
    nom_agence VARCHAR(100) NOT NULL,
    adresse TEXT,
    telephone VARCHAR(20),
    email VARCHAR(100),
    ville VARCHAR(100) NOT NULL,
    pays VARCHAR(50) DEFAULT 'Cameroun',
    date_creation DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- 7. TABLE point_vente
-- =====================================================
CREATE TABLE point_vente (
    id_point_vente INT PRIMARY KEY AUTO_INCREMENT,
    code_point_vente VARCHAR(20) UNIQUE NOT NULL,
    nom_point_vente VARCHAR(100) NOT NULL,
    adresse TEXT,
    telephone VARCHAR(20),
    id_agence INT NOT NULL,
    est_actif BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (id_agence) REFERENCES agence(id_agence) ON DELETE CASCADE
);

-- =====================================================
-- 8. TABLE voyageur
-- =====================================================
CREATE TABLE voyageur (
    id_voyageur INT PRIMARY KEY AUTO_INCREMENT,
    numero_voyageur VARCHAR(20) UNIQUE NOT NULL,
    nom VARCHAR(50) NOT NULL,
    prenom VARCHAR(50) NOT NULL,
    email VARCHAR(100) UNIQUE,
    telephone VARCHAR(20),
    adresse TEXT,
    date_naissance DATE,
    piece_identite VARCHAR(50),
    type_piece ENUM('CNI', 'PASSEPORT', 'PERMIS') DEFAULT 'CNI',
    date_inscription DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- 9. TABLE reservation
-- =====================================================
CREATE TABLE reservation (
    id_reservation INT PRIMARY KEY AUTO_INCREMENT,
    numero_reservation VARCHAR(30) UNIQUE NOT NULL,
    date_reservation DATETIME DEFAULT CURRENT_TIMESTAMP,
    statut ENUM('EN_ATTENTE', 'CONFIRMEE', 'ANNULEE', 'REMBOURSEE', 'EXPIREE') DEFAULT 'EN_ATTENTE',
    prix_total DECIMAL(12, 2) NOT NULL,
    id_voyageur INT NOT NULL,
    id_train INT NOT NULL,
    id_arret_depart INT NOT NULL,
    id_arret_arrivee INT NOT NULL,
    id_siege INT NOT NULL,
    classe_choisie ENUM('PREMIERE', 'SECONDE', 'WAGON_LIT') NOT NULL,
    date_voyage DATE NOT NULL,
    notes TEXT,
    FOREIGN KEY (id_voyageur) REFERENCES voyageur(id_voyageur),
    FOREIGN KEY (id_train) REFERENCES train(id_train),
    FOREIGN KEY (id_arret_depart) REFERENCES arret(id_arret),
    FOREIGN KEY (id_arret_arrivee) REFERENCES arret(id_arret),
    FOREIGN KEY (id_siege) REFERENCES siege(id_siege)
);

-- =====================================================
-- 10. TABLE ticket
-- =====================================================
CREATE TABLE ticket (
    id_ticket INT PRIMARY KEY AUTO_INCREMENT,
    numero_ticket VARCHAR(30) UNIQUE NOT NULL,
    date_emission DATETIME DEFAULT CURRENT_TIMESTAMP,
    prix DECIMAL(12, 2) NOT NULL,
    statut ENUM('VALIDE', 'UTILISE', 'REMBOURSE', 'ANNULE', 'EXPIRE') DEFAULT 'VALIDE',
    code_qr VARCHAR(255),
    id_reservation INT NOT NULL,
    id_point_vente INT,
    FOREIGN KEY (id_reservation) REFERENCES reservation(id_reservation) ON DELETE CASCADE,
    FOREIGN KEY (id_point_vente) REFERENCES point_vente(id_point_vente)
);

-- =====================================================
-- 11. TABLE reclamation
-- =====================================================
CREATE TABLE reclamation (
    id_reclamation INT PRIMARY KEY AUTO_INCREMENT,
    numero_reclamation VARCHAR(30) UNIQUE NOT NULL,
    date_reclamation DATETIME DEFAULT CURRENT_TIMESTAMP,
    description TEXT NOT NULL,
    type ENUM('PLAINTE', 'RECLAMATION', 'SUGGESTION', 'DEMANDE_INFO') DEFAULT 'RECLAMATION',
    statut ENUM('EN_ATTENTE', 'EN_COURS', 'TRAITEE', 'REJETEE') DEFAULT 'EN_ATTENTE',
    reponse TEXT,
    id_voyageur INT NOT NULL,
    id_point_vente INT,
    date_traitement DATETIME,
    FOREIGN KEY (id_voyageur) REFERENCES voyageur(id_voyageur),
    FOREIGN KEY (id_point_vente) REFERENCES point_vente(id_point_vente)
);

-- =====================================================
-- 12. TABLE paiement
-- =====================================================
CREATE TABLE paiement (
    id_paiement INT PRIMARY KEY AUTO_INCREMENT,
    numero_transaction VARCHAR(50) UNIQUE NOT NULL,
    montant DECIMAL(12, 2) NOT NULL,
    date_paiement DATETIME DEFAULT CURRENT_TIMESTAMP,
    mode_paiement ENUM('ESPECES', 'CARTE', 'MOBILE_MONEY', 'VIREMENT') NOT NULL,
    statut ENUM('EN_ATTENTE', 'VALIDE', 'ECHOUE', 'REMBOURSE') DEFAULT 'EN_ATTENTE',
    id_reservation INT NOT NULL,
    reference_externe VARCHAR(100),
    FOREIGN KEY (id_reservation) REFERENCES reservation(id_reservation)
);

-- =====================================================
-- 13. TABLE utilisateur (pour l'administration)
-- =====================================================
CREATE TABLE utilisateur (
    id_utilisateur INT PRIMARY KEY AUTO_INCREMENT,
    nom_utilisateur VARCHAR(50) UNIQUE NOT NULL,
    mot_de_passe VARCHAR(255) NOT NULL,
    nom VARCHAR(50),
    prenom VARCHAR(50),
    email VARCHAR(100),
    role ENUM('ADMIN', 'AGENT', 'COMPTABLE', 'SUPERVISEUR') DEFAULT 'AGENT',
    id_agence INT,
    est_actif BOOLEAN DEFAULT TRUE,
    derniere_connexion DATETIME,
    FOREIGN KEY (id_agence) REFERENCES agence(id_agence)
);

-- =====================================================
-- 14. TABLE journal_activite
-- =====================================================
CREATE TABLE journal_activite (
    id_log INT PRIMARY KEY AUTO_INCREMENT,
    date_action DATETIME DEFAULT CURRENT_TIMESTAMP,
    type_action VARCHAR(50),
    description TEXT,
    id_utilisateur INT,
    ip_adresse VARCHAR(45),
    FOREIGN KEY (id_utilisateur) REFERENCES utilisateur(id_utilisateur)
);

